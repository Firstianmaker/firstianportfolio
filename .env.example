NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Copy this file to .env.local. Leave both blank for the original-content preview.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=

# Optional server-only Viewer token if your dataset is private.
SANITY_API_READ_TOKEN=

# Required only for the one-time import. Use an Editor token, then remove it.
# Never prefix tokens with NEXT_PUBLIC_ or commit .env.local.
SANITY_API_WRITE_TOKEN=
